# Frontend Configuration
# Copy this file to .env and fill in the values

# Backend API URL (for production, use your Render backend URL)
VITE_API_URL=http://localhost:10007

# Encryption Key (MUST match the ENCRYPTION_KEY in backend)
# This is used to encrypt/decrypt Binance API keys in localStorage
# ⚠️ WARNING: This key will be exposed in the client-side bundle!
# For better security, consider moving encryption to backend-only
VITE_ENCRYPTION_KEY=your-secure-encryption-key-here

# Firebase Configuration
# These are not secrets but should match your Firebase project
# VITE_FIREBASE_API_KEY=your-firebase-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
# VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
